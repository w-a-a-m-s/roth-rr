# App secrets (Auth.js, Mongo, Google, email, plans).
# Copy to `.env` and fill in real values. Never commit `.env`.

# Auth.js. The app hosts /api/auth.
AUTH_SECRET=
# Canonical app origin. In production use the public domain.
# A *.vercel.app URL breaks relative Auth.js redirects such as signOut → /.
AUTH_URL=http://localhost:3000
# Trust the Host header. Needed on Vercel and other proxies.
AUTH_TRUST_HOST=true
# Optional public origin for Open Graph / share previews. Defaults to
# AUTH_URL in development, or the canonical domain in production.
# NEXT_PUBLIC_SITE_URL=https://roth-rr.vercel.app

# Optional comma-separated origins allowed as OAuth/magic-link callbackUrl
# (same origin as AUTH_URL is always allowed).
# AUTH_ALLOWED_ORIGINS=https://example.com

# Mongo. Plans, external data, and Auth.js collections (users, sessions,
# accounts, invites) all live in MONGODB_DB.
MONGODB_URI=
MONGODB_DB=roth

# External reference data (see docs/external-data.md)
EXTERNAL_DATA_ADMIN_TOKEN=
# This app serves /api/external-data.
EXTERNAL_DATA_API_URL=http://localhost:3000

# Google OAuth (Authorized redirect URI: ${AUTH_URL}/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email magic link (Mailgun HTTP API; user is always "api", password is API key)
# Support inbox (Reply-To on user mail; To for support forwards). Falls back to
# support@thewealthlab.ai. Prefer NEXT_PUBLIC_ so client mailto links match.
# NEXT_PUBLIC_SUPPORT_EMAIL=support@thewealthlab.ai
# Optional override if EMAIL_FROM domain is not the Mailgun sending domain:
# MAILGUN_DOMAIN=mg.thewealthlab.ai
EMAIL_SERVER_USER=api
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=
# Required when NODE_ENV is not production: all outbound mail is redirected here
# (original recipient is prefixed on the subject). Unused in production.
EMAIL_DEV_TO=you@example.com
# Local IDE login: required ?email= on http://localhost:3000/api/dev/login
# must match this address (trim, case-insensitive). Development + localhost only.
# DEV_LOGIN_EMAIL=you@example.com
# Optional: notify these addresses on magic-link signup attempts (before they
# click) and when a new Auth.js account is created. Comma-separated for more
# than one. In non-production, sendEmail still redirects to EMAIL_DEV_TO.
# REGISTRATION_NOTIFY_EMAIL=you@example.com,other@example.com
